# Copy to .env and fill in real values from your Qdrant Cloud dashboard.
QDRANT_URL=https://your-cluster-url.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-api-key-here
QDRANT_COLLECTION=document_brain
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Override only for testing/proxying; defaults to the real API.
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Secret required in the X-API-Key header to access protected endpoints.
API_KEY=your-secret-key-here
